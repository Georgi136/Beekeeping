{
  "name": "saki-bee-store-server",
  "version": "1.0.0",
  "description": "Пчеларски Магазин САКИ - Дупница - Backend API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema ../../packages/db/prisma/schema.prisma && tsc",
    "db:generate": "prisma generate --schema ../../packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../../packages/db/prisma/schema.prisma",
    "db:seed": "tsx ../../packages/db/seed.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
